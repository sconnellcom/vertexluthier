---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const photo = product.photos[0];
---

<article class="card">
  <a href={`${import.meta.env.BASE_URL}${product.slug}/`}>
    <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy">
    <h2>{product.name}</h2>
  </a>
  <p>{product.price}</p>
  <a class="button" href={product.etsyUrl}>Buy on Etsy</a>
</article>
